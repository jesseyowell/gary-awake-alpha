      "PersonSearchFilter": {
        "title": "PersonSearchFilter",
        "description": "A filter to apply when searching people. You can add a filter for any field of a person and, depending on the data type of the field, the value to filter on. Strings, dates, numbers, and booleans each have their own specific fields that must be used for filtering. You can also specify whether the match should be an exact match, a \"fuzzy\" match, or an \"exists\" match using the `match_type` field. \n\nUse dot-notation to specify fields that are in nested dicts.\n\nTo search for multiple criteria within a given job (i.e. \"an engineer at Amazon\"), use a FilterGroup to group the criteria with an `AND` operator. Note that when using this approach the FilterGroup must contain **only** `jobs.` filters within it.\n\nFilters are combined using the `AND` operator. ",
        "allOf": [
          {
            "$ref": "#/components/schemas/SearchFilter"
          }
        ],
        "x-examples": {
          "Example 1": {
            "type": "must",
            "field": "string",
            "string_values": [
              "string"
            ],
            "date_from": "2019-08-24T14:15:22Z",
            "date_to": "2019-08-24T14:15:22Z",
            "number_min": 0,
            "number_max": 0,
            "boolean_value": true,
            "match_type": "fuzzy"
          }
        }
      },
      "SearchFilter": {
        "type": "object",
        "title": "SearchFilter",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "must",
              "must_not"
            ],
            "description": "Either 'must' or 'must_not'"
          },
          "field": {
            "type": "string",
            "description": "The name of the field in OS"
          },
          "string_values": {
            "type": "array",
            "description": "If the field is a text field, an array of values that must/must-not match",
            "items": {
              "type": "string"
            }
          },
          "date_from": {
            "type": "string",
            "description": "If the field is a date field, this is the \"from\" date to use"
          },
          "date_to": {
            "type": "string",
            "description": "If the field is a date field, this is the \"to\" date to use"
          },
          "number_min": {
            "type": "number",
            "description": "If the field is a number field, the min number tha t must match"
          },
          "number_max": {
            "type": "number",
            "description": "If the field is a number field, the max number tha t must match"
          },
          "boolean_value": {
            "type": "boolean",
            "description": "If the field is a boolean, this value will be used for the filter"
          },
          "match_type": {
            "type": "string",
            "enum": [
              "fuzzy",
              "exact",
              "exists"
            ],
            "description": "Specifies what kind of match to do on the field: \n* `fuzzy` - match the value in a fuzzy manner\n* `exact` - match the value exactly\n* `exists` - only query the existence of the field, not a value match\n\n`fuzzy` and `exact` only apply to string fields, not dates, numbers, or bools",
            "default": "fuzzy"
          }
        }
      }
